---
import { faqs } from "@/data/faq";
import { t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props as Props;
---

<div class="grid gap-3">
  {faqs.map((faq, index) => (
    <details class="card p-5" open={index === 0}>
      <summary class="cursor-pointer font-black text-brand-800">{t(faq.qZh, faq.qEn, lang)}</summary>
      <p class="mt-3 text-slate-600">{t(faq.aZh, faq.aEn, lang)}</p>
    </details>
  ))}
</div>
