---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { navItems, site } from "@/data/site";
import { localizePath, t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Props {
  lang: SiteLang;
  path: string;
}

const { lang, path } = Astro.props as Props;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="border-b border-slate-100 bg-white text-xs text-slate-600">
    <div class="container-page flex min-h-8 flex-wrap items-center justify-between gap-2 py-1">
      <span>{t("中国大陆本地调查协助 · 先评估后接案", "Mainland China local investigation support · Assessment before acceptance", lang)}</span>
      <a class="font-bold text-brand-700" href={site.officialWebsite} target="_blank" rel="noopener noreferrer">{t("星外天官网", "Official Website", lang)}</a>
    </div>
  </div>

  <div class="container-page">
    <div class="flex min-h-[66px] items-center justify-between gap-3 py-2 lg:min-h-[74px]">
      <a class="flex min-w-0 items-center gap-3 font-black text-brand-800" href={localizePath("/", lang)} aria-label={t(site.nameZh, site.nameEn, lang)}>
        <span class="grid size-11 shrink-0 place-items-center bg-[#102033] text-lg text-white">X</span>
        <span class="min-w-0 leading-tight">
          <span class="block truncate text-sm sm:text-lg">{t(site.nameZh, site.nameEn, lang)}</span>
          <small class="block text-xs font-semibold text-slate-500">{t("专业机构 · 诚信服务", "Professional · Integrity", lang)}</small>
        </span>
      </a>

      <div class="flex shrink-0 items-center gap-2 sm:gap-4">
        <nav class="hidden items-center gap-7 text-sm font-bold text-slate-600 lg:flex" aria-label={t("主导航", "Primary navigation", lang)}>
          {navItems.map((item) => (
            <a class="hover:text-brand-700" href={localizePath(item.href, lang)}>{t(item.zh, item.en, lang)}</a>
          ))}
        </nav>
        <LanguageSwitcher lang={lang} path={path} />
        <a class="button button-primary hidden sm:inline-flex" href={localizePath("/contact/", lang)}>{t("提交咨询", "Start Inquiry", lang)}</a>
      </div>
    </div>

    <details class="mobile-menu border-t border-slate-100 py-2 lg:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between rounded px-1 py-2 text-sm font-black text-brand-800">
        <span>{t("导航菜单", "Navigation", lang)}</span>
        <span class="menu-mark grid size-8 place-items-center rounded border border-slate-200 text-lg leading-none" aria-hidden="true">+</span>
      </summary>
      <nav class="grid grid-cols-2 gap-2 pb-2 pt-1 text-sm font-bold text-slate-700" aria-label={t("移动主导航", "Mobile primary navigation", lang)}>
        {navItems.map((item) => (
          <a class="rounded border border-slate-200 bg-white px-3 py-2 hover:border-brand-600 hover:text-brand-700" href={localizePath(item.href, lang)}>{t(item.zh, item.en, lang)}</a>
        ))}
        <a class="rounded border border-slate-200 bg-white px-3 py-2 hover:border-brand-600 hover:text-brand-700" href={site.officialWebsite} target="_blank" rel="noopener noreferrer">{t("官网", "Official", lang)}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] .menu-mark {
    transform: rotate(45deg);
  }
</style>
