---
import { localizePath, t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props as Props;
---

<section class="bg-white py-16 lg:py-20">
  <div class="container-page">
    <div class="grid gap-6 bg-[#102033] p-8 text-white md:grid-cols-[1fr_auto] md:items-center md:p-12">
      <div>
        <p class="text-sm font-black uppercase tracking-[.18em] text-[#e7a33a]">{t("开始评估", "Start Assessment", lang)}</p>
        <h2 class="mt-3 text-3xl font-black leading-tight md:text-4xl">{t("需要确认中国境内的真实情况？", "Need to Clarify a Situation in China?", lang)}</h2>
        <p class="mt-2 max-w-2xl text-white/85">{t("提交背景信息后，我们会先评估合法性、可行性和风险，再决定是否接受委托。", "Share the background first. We assess legality, feasibility, and risk before accepting any request.", lang)}</p>
      </div>
      <a class="button bg-white text-[#102033]" href={localizePath("/contact/", lang)}>{t("提交咨询", "Start Inquiry", lang)}</a>
    </div>
  </div>
</section>
