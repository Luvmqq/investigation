---
import { navItems, site } from "@/data/site";
---

<footer class="border-t border-slate-200 bg-[#f0f4f7] pt-12 text-sm text-slate-600">
  <div class="container-page grid gap-10 pb-10 md:grid-cols-[1.2fr_.9fr_.9fr_1fr]">
    <div>
      <strong class="block text-lg text-ink">{site.companyEn}</strong>
      <span class="mt-1 block">{site.companyZh}</span>
      <p class="mt-4 max-w-sm" data-zh="面向海外华人的中国大陆本地调查协助服务，强调合规、保密与现实情况评估。" data-en="Mainland China local investigation support for overseas Chinese clients, focused on compliance, confidentiality, and practical situation assessment.">面向海外华人的中国大陆本地调查协助服务，强调合规、保密与现实情况评估。</p>
    </div>

    <nav class="grid gap-2" aria-label="Footer service">
      <strong class="text-slate-800" data-zh="服务" data-en="Services">服务</strong>
      {navItems.slice(1, 4).map((item) => (
        <a class="hover:text-brand-700" href={item.href} data-zh={item.zh} data-en={item.en}>{item.zh}</a>
      ))}
    </nav>

    <nav class="grid gap-2" aria-label="Footer explore">
      <strong class="text-slate-800" data-zh="探索" data-en="Explore">探索</strong>
      <a href="/about/" data-zh="关于我们" data-en="About Us">关于我们</a>
      <a href="/blog/" data-zh="文章" data-en="Blog">文章</a>
      <a href="/privacy-policy/" data-zh="隐私政策" data-en="Privacy Policy">隐私政策</a>
      <a href="/legal-disclaimer/" data-zh="合规声明" data-en="Legal Disclaimer">合规声明</a>
    </nav>

    <div>
      <strong class="text-slate-800" data-zh="联系渠道" data-en="Contact Channels">联系渠道</strong>
      <div class="mt-3 flex flex-wrap gap-2">
        <a class="button button-secondary min-h-10 px-3 py-2 text-xs" href="/contact/">WhatsApp</a>
        <a class="button button-secondary min-h-10 px-3 py-2 text-xs" href="/contact/">Telegram</a>
        <a class="button button-secondary min-h-10 px-3 py-2 text-xs" href="/contact/" data-zh="微信" data-en="WeChat">微信</a>
      </div>
      <a class="mt-4 block font-bold text-brand-700" href={site.officialWebsite} target="_blank" rel="noopener noreferrer" data-zh="星外天官网" data-en="Official Website">星外天官网</a>
    </div>
  </div>
  <div class="border-t border-slate-200 bg-white py-4">
    <div class="container-page flex flex-wrap justify-between gap-3 text-xs text-slate-500">
      <span>© 2026 {site.nameEn}</span>
      <span data-zh="所有委托需先评估合法性与可行性" data-en="All requests require legality and feasibility assessment">所有委托需先评估合法性与可行性</span>
    </div>
  </div>
</footer>
