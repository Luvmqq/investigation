---
import { site } from "@/data/site";
---

<footer class="border-t border-slate-200 bg-white py-10 text-sm text-slate-500">
  <div class="container-page flex flex-wrap items-start justify-between gap-6">
    <div>
      <strong class="block text-slate-700">{site.companyEn}</strong>
      <span>{site.companyZh}</span>
      <p class="mt-2">© 2026 {site.nameEn}</p>
    </div>
    <nav class="flex flex-wrap gap-4 font-semibold" aria-label="Footer">
      <a href={site.officialWebsite} target="_blank" rel="noopener noreferrer" data-zh="星外天官网" data-en="Official Website">星外天官网</a>
      <a href="/privacy-policy/" data-zh="隐私政策" data-en="Privacy Policy">隐私政策</a>
      <a href="/legal-disclaimer/" data-zh="合规声明" data-en="Legal Disclaimer">合规声明</a>
      <a href="/contact/" data-zh="联系" data-en="Contact">联系</a>
    </nav>
  </div>
</footer>
