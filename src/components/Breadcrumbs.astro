---
interface Crumb {
  href: string;
  labelZh: string;
  labelEn: string;
}

const { items = [] } = Astro.props as { items: Crumb[] };
---

<nav class="container-page py-4 text-sm text-slate-500" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a class="hover:text-brand-600" href="/" data-zh="首页" data-en="Home">首页</a></li>
    {items.map((item) => (
      <>
        <li aria-hidden="true">/</li>
        <li><a class="hover:text-brand-600" href={item.href} data-zh={item.labelZh} data-en={item.labelEn}>{item.labelZh}</a></li>
      </>
    ))}
  </ol>
</nav>
