---
import { localizePath, t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Crumb {
  href: string;
  labelZh: string;
  labelEn: string;
  labelTw?: string;
}

const { items = [], lang = "zh" } = Astro.props as { items: Crumb[]; lang?: SiteLang };
---

<nav class="container-page py-4 text-sm text-slate-500" aria-label={t("面包屑导航", "Breadcrumb", lang)}>
  <ol class="flex flex-wrap items-center gap-2">
    <li><a class="hover:text-brand-600" href={localizePath("/", lang)}>{t("首页", "Home", lang)}</a></li>
    {items.map((item) => (
      <>
        <li aria-hidden="true">/</li>
        <li><a class="hover:text-brand-600" href={localizePath(item.href, lang)}>{t(item.labelZh, item.labelEn, lang, item.labelTw)}</a></li>
      </>
    ))}
  </ol>
</nav>
