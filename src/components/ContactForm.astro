---
import { t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props as Props;
---

<form class="card grid gap-4 p-6" name="contact" method="POST" data-netlify="true" netlify-honeypot="company">
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Company <input name="company" /></label>
  </p>
  <label class="grid gap-1 text-sm font-bold text-slate-700">
    <span>{t("姓名", "Name", lang)}</span>
    <input class="rounded-lg border border-slate-200 px-4 py-3" name="name" type="text" autocomplete="name" required placeholder={t("姓名", "Name", lang)} />
  </label>
  <label class="grid gap-1 text-sm font-bold text-slate-700">
    <span>{t("邮箱或 WhatsApp", "Email / WhatsApp", lang)}</span>
    <input class="rounded-lg border border-slate-200 px-4 py-3" name="contact" type="text" autocomplete="email" required placeholder={t("邮箱或 WhatsApp", "Email / WhatsApp", lang)} />
  </label>
  <label class="grid gap-1 text-sm font-bold text-slate-700">
    <span>{t("所在国家/地区", "Country / Region", lang)}</span>
    <input class="rounded-lg border border-slate-200 px-4 py-3" name="country" type="text" placeholder={t("例如：美国、加拿大、新加坡", "For example: US, Canada, Singapore", lang)} />
  </label>
  <label class="grid gap-1 text-sm font-bold text-slate-700">
    <span>{t("委托类型", "Type of case", lang)}</span>
    <select class="rounded-lg border border-slate-200 px-4 py-3" name="caseType">
      <option>{t("婚恋关系调查", "Relationship investigation", lang)}</option>
      <option>{t("个人背景调查", "Background investigation", lang)}</option>
      <option>{t("寻人协助", "Locate someone", lang)}</option>
      <option>{t("债务人线索", "Debtor location", lang)}</option>
      <option>{t("其他私人委托", "Other private matter", lang)}</option>
    </select>
  </label>
  <label class="grid gap-1 text-sm font-bold text-slate-700">
    <span>{t("情况描述", "Description", lang)}</span>
    <textarea class="min-h-36 rounded-lg border border-slate-200 px-4 py-3" name="description" required placeholder={t("请简要描述事情经过和你想了解的问题", "Briefly describe what happened and what you need to understand", lang)}></textarea>
  </label>
  <button class="button button-primary" type="submit">{t("提交咨询", "Send Inquiry", lang)}</button>
</form>
