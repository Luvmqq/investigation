---
import { localizePath } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Props {
  lang: SiteLang;
  path: string;
}

const { lang, path } = Astro.props as Props;

const options: Array<{ code: SiteLang; label: string }> = [
  { code: "zh", label: "简" },
  { code: "zh-hant", label: "繁" },
  { code: "en", label: "EN" }
];
---

<div class="flex rounded-full border border-slate-200 bg-white p-1" aria-label="Language switch">
  {options.map((option) => (
    <a class:list={["lang-button", { active: option.code === lang }]} href={localizePath(path, option.code)} hrefLang={option.code}>
      {option.label}
    </a>
  ))}
</div>

<style>
  .lang-button {
    align-items: center;
    display: inline-flex;
    justify-content: center;
    min-width: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #64748b;
    font-weight: 900;
    padding: 0.4rem 0.6rem;
    text-decoration: none;
  }

  .lang-button.active {
    background: #1f4f82;
    color: white;
  }
</style>
