---
import { credentials, site, trustHighlights } from "@/data/site";
import { t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props as Props;
---

<section class="section-space bg-white">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
      <div>
        <p class="section-label">{t("资质信息", "Credentials", lang)}</p>
        <h2 class="section-title mt-4">{t("10+年行业经验与官网资质信息", "10+ Years of Experience and Official Credentials", lang)}</h2>
        <p class="mt-4 text-slate-600">{t("基于南京星外天原官网公开信息，本站以更适合海外客户和合规传播的方式呈现机构背景、服务理念与资质说明。", "Based on public information from the original Nanjing Xingwaitian website, this site presents the organization's background, service philosophy, and credentials in a compliance-focused way for overseas clients.", lang)}</p>
        <a class="button button-secondary mt-6" href={site.officialWebsite} target="_blank" rel="noopener noreferrer">{t("访问星外天官网", "Visit Official Website", lang)}</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {trustHighlights.map((item) => (
          <article class="card p-5">
            <strong class="block text-3xl font-black text-brand-700">{t(item.valueZh, item.valueEn, lang)}</strong>
            <h3 class="mt-2 text-lg font-black text-ink">{t(item.labelZh, item.labelEn, lang)}</h3>
            <p class="mt-3 text-sm text-slate-600">{t(item.noteZh, item.noteEn, lang)}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {credentials.map((item) => (
        <article class="card p-5">
          <h3 class="text-lg font-black text-brand-800">{t(item.titleZh, item.titleEn, lang)}</h3>
          <p class="mt-3 text-sm text-slate-600">{t(item.bodyZh, item.bodyEn, lang)}</p>
        </article>
      ))}
    </div>
  </div>
</section>
