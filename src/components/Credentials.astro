---
import { credentials, site, trustHighlights } from "@/data/site";
---

<section class="section-space bg-white">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
      <div>
        <p class="section-label" data-zh="Credentials" data-en="Credentials">Credentials</p>
        <h2 class="section-title mt-4" data-zh="10+年行业经验与官网资质信息" data-en="10+ Years of Experience and Official Credentials">10+年行业经验与官网资质信息</h2>
        <p class="mt-4 text-slate-600" data-zh="基于南京星外天原官网公开信息，本站以更适合海外客户和合规传播的方式呈现机构背景、服务理念与资质说明。" data-en="Based on public information from the original Nanjing Xingwaitian website, this site presents the organization's background, service philosophy, and credentials in a compliance-focused way for overseas clients.">基于南京星外天原官网公开信息，本站以更适合海外客户和合规传播的方式呈现机构背景、服务理念与资质说明。</p>
        <a class="button button-secondary mt-6" href={site.officialWebsite} target="_blank" rel="noopener noreferrer" data-zh="访问星外天官网" data-en="Visit Official Website">访问星外天官网</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {trustHighlights.map((item) => (
          <article class="card p-5">
            <strong class="block text-3xl font-black text-brand-700" data-zh={item.valueZh} data-en={item.valueEn}>{item.valueZh}</strong>
            <h3 class="mt-2 text-lg font-black text-ink" data-zh={item.labelZh} data-en={item.labelEn}>{item.labelZh}</h3>
            <p class="mt-3 text-sm text-slate-600" data-zh={item.noteZh} data-en={item.noteEn}>{item.noteZh}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {credentials.map((item) => (
        <article class="card p-5">
          <h3 class="text-lg font-black text-brand-800" data-zh={item.titleZh} data-en={item.titleEn}>{item.titleZh}</h3>
          <p class="mt-3 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
        </article>
      ))}
    </div>
  </div>
</section>
