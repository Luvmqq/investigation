---
const certificates = [
  {
    src: "/images/trust/trust-01.jpg",
    titleZh: "中国民间调查行业联盟常务理事单位",
    titleEn: "Standing Council Member",
    noteZh: "行业联盟资质背书",
    noteEn: "Industry alliance credential"
  },
  {
    src: "/images/trust/trust-02.jpg",
    titleZh: "江苏诚信服务单位",
    titleEn: "Jiangsu Integrity Service Unit",
    noteZh: "诚信服务单位牌匾",
    noteEn: "Integrity service recognition"
  },
  {
    src: "/images/trust/trust-03.jpg",
    titleZh: "中国商务调查精英合作单位",
    titleEn: "Business Investigation Cooperation Unit",
    noteZh: "商务合作与诚信单位",
    noteEn: "Business cooperation credential"
  },
  {
    src: "/images/trust/trust-04.jpg",
    titleZh: "营业执照",
    titleEn: "Business License",
    noteZh: "正规登记主体信息",
    noteEn: "Registered business entity"
  },
  {
    src: "/images/trust/trust-05.jpg",
    titleZh: "中国民间调查联盟理事",
    titleEn: "Investigation Alliance Council Member",
    noteZh: "联盟理事单位牌匾",
    noteEn: "Alliance council recognition"
  },
  {
    src: "/images/trust/trust-06.jpg",
    titleZh: "行业活动合影",
    titleEn: "Industry Event Photo",
    noteZh: "线下行业交流记录",
    noteEn: "Offline industry participation"
  }
];
---

<section class="bg-white py-16 lg:py-20">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-sm font-black text-brand-700" data-zh="资质与信任背书" data-en="Credentials and Trust">资质与信任背书</span>
        <h2 class="section-title mt-4" data-zh="真实资质展示，增强委托信任感" data-en="Credential Display for Stronger Trust">真实资质展示，增强委托信任感</h2>
      </div>
      <p class="text-slate-600" data-zh="以下图片用于展示星外天过往资质、诚信服务与正规登记信息。本站仍坚持先评估、后接案，不提供任何违法信息获取服务。" data-en="The following images show Xingwaitian's past credentials, integrity service recognition, and registered business information. This site still follows assessment before acceptance and does not provide unlawful information access.">以下图片用于展示星外天过往资质、诚信服务与正规登记信息。本站仍坚持先评估、后接案，不提供任何违法信息获取服务。</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {certificates.map((item) => (
        <figure class="trust-figure card overflow-hidden bg-slate-50">
          <div class="relative aspect-[4/3] bg-slate-100">
            <img
              class="size-full object-cover"
              src={item.src}
              alt={item.titleZh}
              loading="lazy"
              onerror="this.closest('figure').classList.add('is-missing')"
            />
            <div class="trust-fallback absolute inset-0 hidden place-items-center p-5 text-center">
              <div>
                <strong class="block text-brand-800" data-zh="等待图片文件" data-en="Image file pending">等待图片文件</strong>
                <span class="mt-1 block text-xs text-slate-500">{item.src}</span>
              </div>
            </div>
          </div>
          <figcaption class="p-4">
            <h3 class="font-black text-ink" data-zh={item.titleZh} data-en={item.titleEn}>{item.titleZh}</h3>
            <p class="mt-1 text-sm text-slate-600" data-zh={item.noteZh} data-en={item.noteEn}>{item.noteZh}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-figure.is-missing img {
    display: none;
  }

  .trust-figure.is-missing .trust-fallback {
    display: grid;
  }
</style>
