---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { site } from "@/data/site";
import { t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

const { lang } = Astro.props as { lang: SiteLang };

const title = t(`合规声明 | ${site.nameZh}`, `Legal Disclaimer | ${site.nameEn}`, lang);
const description = t("中国大陆调查协助服务合规声明：不提供黑客、手机定位、开房记录、通信记录、银行流水等违法服务。", "Legal disclaimer for mainland China investigation support: no hacking, phone tracking, hotel records, communication records, bank records, or other unlawful services.", lang);
---

<BaseLayout title={title} description={description} path="/legal-disclaimer/" lang={lang}>
  <main>
    <Breadcrumbs lang={lang} items={[{ href: "/legal-disclaimer/", labelZh: "合规声明", labelEn: "Legal Disclaimer" }]} />
    <section class="bg-white py-16">
      <article class="container-page prose prose-slate max-w-4xl">
        <h1>{t("合规声明", "Legal Disclaimer", lang)}</h1>
        <p>{t("本网站提供的是中国大陆本地调查协助、公开信息研究、情况了解和现实情况评估，不承诺任何违法方式获取信息。", "This website provides local investigation assistance, public information research, situation assessment, and practical support in mainland China. We do not promise to obtain information through unlawful methods.", lang)}</p>
        <h2>{t("禁止服务", "Prohibited Services", lang)}</h2>
        <p>{t("我们不提供黑客入侵、手机定位、开房记录、通信记录、银行流水、非法个人信息获取、偷拍或任何侵犯他人合法权益的服务。", "We do not provide hacking, phone tracking, hotel records, communication records, bank records, unlawful personal data access, covert filming, or any service that infringes others' lawful rights.", lang)}</p>
        <h2>{t("委托责任", "Client Responsibility", lang)}</h2>
        <p>{t("客户需保证委托目的合法、正当，并对提供资料的真实性和合法来源负责。", "Clients must ensure that the purpose of the request is lawful and legitimate, and are responsible for the truthfulness and lawful source of provided materials.", lang)}</p>
        <h2>{t("接案评估", "Case Review", lang)}</h2>
        <p>{t("所有委托都需要先评估。对于不适合、风险过高或可能涉及违法的事项，我们会拒绝接受。", "All requests require assessment. We decline matters that are unsuitable, high-risk, or potentially unlawful.", lang)}</p>
      </article>
    </section>
  </main>
</BaseLayout>
