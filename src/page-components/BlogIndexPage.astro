---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { site } from "@/data/site";
import { formatDate, localizePath, t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

const { lang } = Astro.props as { lang: SiteLang };
const posts = (await getCollection("blog")).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = t(`调查协助文章 | ${site.nameZh}`, `Investigation Support Blog | ${site.nameEn}`, lang);
const description = t("中国调查协助、关系核实、寻人协助、债务人线索调查等面向海外华人的原创指南。", "Practical investigation support guides for overseas Chinese clients about relationships, locating people, background checks, and debtor clues in mainland China.", lang);
---

<BaseLayout title={title} description={description} path="/blog/" lang={lang}>
  <main>
    <Breadcrumbs lang={lang} items={[{ href: "/blog/", labelZh: "文章", labelEn: "Blog" }]} />
    <section class="bg-white py-16">
      <div class="container-page">
        <h1 class="text-5xl font-black text-ink">{t("调查协助文章", "Investigation Support Blog", lang)}</h1>
        <p class="mt-5 max-w-3xl text-lg text-slate-600">{t("围绕海外华人常见的跨境关系、寻人、背景了解和债务线索场景，发布可长期运营的 SEO 内容。", "Practical SEO articles for overseas Chinese clients about cross-border relationships, locating people, background checks, and debtor clues.", lang)}</p>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {posts.map((post) => (
            <article class="card p-6">
              <p class="text-sm font-black text-brand-700">{post.data.category}</p>
              <h2 class="mt-2 text-2xl font-black text-ink"><a href={localizePath(`/blog/${post.slug}/`, lang)}>{post.data.title}</a></h2>
              <p class="mt-3 text-slate-600">{post.data.description}</p>
              <time class="mt-4 block text-sm text-slate-500" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
