---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CTA from "@/components/CTA.astro";
import FAQ from "@/components/FAQ.astro";
import { faqs } from "@/data/faq";
import { site } from "@/data/site";
import { localizePath, t } from "@/lib/i18n";
import type { SiteLang } from "@/lib/i18n";

interface Service {
  slug: string;
  titleZh: string;
  titleEn: string;
  descriptionZh: string;
  descriptionEn: string;
  bulletsZh: string[];
  bulletsEn: string[];
  seoTitle: string;
  seoDescription: string;
}

interface Props {
  lang: SiteLang;
  service: Service;
}

const { service, lang } = Astro.props as Props;
const path = `/services/${service.slug}/`;

const title = t(service.titleZh, service.titleEn, lang);
const description = lang === "en" ? service.descriptionEn : t(service.seoDescription, service.seoDescription, lang);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: t(service.titleZh, service.titleEn, lang),
    alternateName: service.titleZh,
    description,
    provider: { "@type": "Organization", name: site.companyEn, alternateName: site.companyZh },
    areaServed: "Mainland China"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("首页", "Home", lang), item: new URL(localizePath("/", lang), site.url).toString() },
      { "@type": "ListItem", position: 2, name: t(service.titleZh, service.titleEn, lang), item: new URL(localizePath(path, lang), site.url).toString() }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: t(faq.qZh, faq.qEn, lang), acceptedAnswer: { "@type": "Answer", text: t(faq.aZh, faq.aEn, lang) } }))
  }
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} lang={lang}>
  <main>
    <Breadcrumbs lang={lang} items={[{ href: path, labelZh: service.titleZh, labelEn: service.titleEn }]} />
    <section class="bg-white py-16">
      <div class="container-page grid gap-10 lg:grid-cols-[1fr_.8fr] lg:items-start">
        <div>
          <span class="inline-flex rounded-full bg-brand-50 px-3 py-1 text-sm font-black text-brand-700">{t("中国大陆本地调查支持", "Local Investigation Support in Mainland China", lang)}</span>
          <h1 class="mt-5 text-5xl font-black leading-tight text-ink">{t(service.titleZh, service.titleEn, lang)}</h1>
          <p class="mt-5 text-lg text-slate-600">{t(service.descriptionZh, service.descriptionEn, lang)}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button button-primary" href={localizePath("/contact/", lang)}>{t("咨询该服务", "Ask About This Service", lang)}</a>
            <a class="button button-secondary" href={localizePath("/legal-disclaimer/", lang)}>{t("查看合规说明", "View Legal Disclaimer", lang)}</a>
          </div>
        </div>
        <aside class="card p-6">
          <h2 class="text-2xl font-black text-brand-800">{t("可协助方向", "What We Can Help With", lang)}</h2>
          <ul class="mt-5 grid gap-3">
            {service.bulletsZh.map((item, index) => (
              <li class="flex gap-3 text-slate-700">
                <span class="mt-2 size-2 rounded-full bg-brand-600"></span>
                <span>{t(item, service.bulletsEn[index], lang)}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>
    <section class="py-16">
      <div class="container-page grid gap-6 md:grid-cols-3">
        <article class="card p-6">
          <h2 class="text-xl font-black text-brand-800">{t("适用人群", "Who It Helps", lang)}</h2>
          <p class="mt-3 text-slate-600">{t("海外华人、港澳台、新加坡、北美和澳洲等需要中国本地协助的跨境客户。", "Overseas Chinese and cross-border clients who need local assistance in China.", lang)}</p>
        </article>
        <article class="card p-6">
          <h2 class="text-xl font-black text-brand-800">{t("信息边界", "Information Boundary", lang)}</h2>
          <p class="mt-3 text-slate-600">{t("重点基于公开信息研究、现实情况评估和合法合规的本地协助。", "Focused on public information research, practical situation assessment, and lawful local support.", lang)}</p>
        </article>
        <article class="card p-6">
          <h2 class="text-xl font-black text-brand-800">{t("先评估后接案", "Assessment First", lang)}</h2>
          <p class="mt-3 text-slate-600">{t("我们会先确认委托目的、资料基础、可行性和风险，再决定是否接受。", "We review purpose, available information, feasibility, and risk before accepting a case.", lang)}</p>
        </article>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="container-page grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div>
          <h2 class="section-title">{t("服务问答", "Service FAQ", lang)}</h2>
          <p class="mt-4 text-slate-600">{t("以下问题适用于大部分调查协助委托。", "These answers apply to most investigation assistance requests.", lang)}</p>
        </div>
        <FAQ lang={lang} />
      </div>
    </section>
    <CTA lang={lang} />
  </main>
</BaseLayout>
