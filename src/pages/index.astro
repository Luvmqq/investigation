---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/CTA.astro";
import Credentials from "@/components/Credentials.astro";
import FAQ from "@/components/FAQ.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import TrustGallery from "@/components/TrustGallery.astro";
import { faqs } from "@/data/faq";
import { services } from "@/data/services";
import { site } from "@/data/site";

const title = site.defaultTitle;
const description = site.defaultDescription;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.companyEn,
    alternateName: site.companyZh,
    url: site.url,
    sameAs: [site.officialWebsite],
    email: site.email
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.nameEn,
    alternateName: site.nameZh,
    url: site.url
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.qZh,
      acceptedAnswer: { "@type": "Answer", text: faq.aZh }
    }))
  }
];

const audiences = [
  {
    titleZh: "跨境关系判断",
    titleEn: "Relationship Decisions",
    bodyZh: "帮助海外客户了解中国境内关系对象的现实情况、生活状态和重要疑点。",
    bodyEn: "Understand practical context, lifestyle consistency, and key concerns about a person in China."
  },
  {
    titleZh: "私人委托评估",
    titleEn: "Private Matter Assessment",
    bodyZh: "围绕个人背景、公开信息、线下线索和可行性进行谨慎评估。",
    bodyEn: "Review background clues, public information, offline context, and feasibility with discretion."
  },
  {
    titleZh: "寻人与债务线索",
    titleEn: "Locating and Debt Clues",
    bodyZh: "为失联人员、亲友、前任、债务人等场景提供中国本地协助。",
    bodyEn: "Local support for lost contacts, relatives, former partners, and debtor clue situations."
  }
];

const why = [
  { zh: "中立评估", en: "Objective", bodyZh: "不夸大承诺，先判断资料基础、合法性和可执行方式。", bodyEn: "No exaggerated promises; we first assess information, legality, and feasibility." },
  { zh: "保密处理", en: "Confidential", bodyZh: "私人委托资料谨慎处理，避免不必要的信息扩散。", bodyEn: "Private case information is handled discreetly and with limited exposure." },
  { zh: "本地经验", en: "China Expertise", bodyZh: "结合中国大陆本地沟通环境、城市线索和现实情况进行判断。", bodyEn: "Assessment is grounded in mainland China communication habits and local context." },
  { zh: "清晰边界", en: "Clear Boundaries", bodyZh: "不提供黑客、定位、记录查询等违法服务，降低委托风险。", bodyEn: "No hacking, phone tracking, or unlawful record access, reducing client risk." }
];

const process = [
  { zh: "提交情况", en: "Submit Context", bodyZh: "说明背景、所在国家和你需要确认的问题。", bodyEn: "Share the background, your country, and what you need to clarify." },
  { zh: "合规评估", en: "Compliance Review", bodyZh: "确认目的是否合法、资料是否足够、是否适合接案。", bodyEn: "We review purpose, available information, legality, and suitability." },
  { zh: "本地协助", en: "Local Support", bodyZh: "按约定范围进行公开信息研究、线索整理或线下核实。", bodyEn: "Public information research, clue organization, or offline verification within the agreed scope." },
  { zh: "结果反馈", en: "Result Summary", bodyZh: "以可理解的方式总结现实情况、风险和下一步建议。", bodyEn: "Receive a clear summary of the situation, risks, and possible next steps." }
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <main>
    <section class="relative overflow-hidden bg-white">
      <div class="absolute inset-x-0 top-0 h-40 bg-[#e8f0f6]"></div>
      <div class="container-page relative grid gap-10 py-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-20">
        <div>
          <span class="eyebrow" data-zh="Local Investigation Support" data-en="Local Investigation Support">Local Investigation Support</span>
          <h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.08] text-ink sm:text-5xl md:text-6xl" data-zh="中国大陆本地调查协助服务" data-en="Investigation Assistance in Mainland China">中国大陆本地调查协助服务</h1>
          <p class="mt-5 max-w-2xl text-lg text-slate-600" data-zh="为海外华人和跨境客户提供关系情况了解、个人背景评估、寻人协助与债务人线索调查支持。先评估合法性与可行性，再决定是否接受委托。" data-en="Local support for overseas Chinese and cross-border clients who need relationship clarification, background assessment, locating assistance, and debtor clue investigation in mainland China.">为海外华人和跨境客户提供关系情况了解、个人背景评估、寻人协助与债务人线索调查支持。先评估合法性与可行性，再决定是否接受委托。</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button button-primary" href="/contact/" data-zh="提交咨询" data-en="Start Inquiry">提交咨询</a>
            <a class="button button-secondary" href="#services" data-zh="查看服务范围" data-en="View Services">查看服务范围</a>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {[
              ["10+年行业经验", "10+ Years"],
              ["专业机构", "Professional"],
              ["诚信服务", "Integrity"],
              ["保密处理", "Confidential"]
            ].map(([zh, en]) => (
              <div class="border-l-4 border-[#e7a33a] bg-slate-50 p-4 text-sm font-black text-slate-700" data-zh={zh} data-en={en}>{zh}</div>
            ))}
          </div>
        </div>

        <div class="checkup-panel p-4">
          <img class="aspect-[4/3] w-full object-cover" src="/images/china-business-scene.svg" alt="China city and business communication scene" loading="eager" />
          <div class="grid gap-3 border-x border-b border-slate-200 p-5 sm:grid-cols-3">
            <div>
              <strong class="block text-2xl font-black text-brand-700">4</strong>
              <span class="text-xs font-bold text-slate-600" data-zh="核心服务方向" data-en="Core service areas">核心服务方向</span>
            </div>
            <div>
              <strong class="block text-2xl font-black text-brand-700">6</strong>
              <span class="text-xs font-bold text-slate-600" data-zh="资质图片展示" data-en="Credential images">资质图片展示</span>
            </div>
            <div>
              <strong class="block text-2xl font-black text-brand-700">0</strong>
              <span class="text-xs font-bold text-slate-600" data-zh="违法服务承诺" data-en="Illegal service promises">违法服务承诺</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-[#f0f4f7] py-14">
      <div class="container-page">
        <h2 class="text-center text-3xl font-black text-ink" data-zh="谁会使用我们的调查协助？" data-en="Who Uses Our Investigation Support?">谁会使用我们的调查协助？</h2>
        <p class="mx-auto mt-3 max-w-3xl text-center text-slate-600" data-zh="海外客户通常不是要冒险获取隐私，而是需要在重要关系、财务或家庭决策前降低不确定性。" data-en="Overseas clients usually need to reduce uncertainty before important relationship, financial, or family decisions.">海外客户通常不是要冒险获取隐私，而是需要在重要关系、财务或家庭决策前降低不确定性。</p>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {audiences.map((item) => (
            <article class="card p-6 text-center">
              <div class="mx-auto grid size-14 place-items-center rounded-full bg-brand-50 text-2xl font-black text-brand-700">✓</div>
              <h3 class="mt-4 text-xl font-black text-ink" data-zh={item.titleZh} data-en={item.titleEn}>{item.titleZh}</h3>
              <p class="mt-3 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="services" class="bg-white py-16 lg:py-20">
      <div class="container-page">
        <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
          <div>
            <span class="eyebrow" data-zh="Our Services" data-en="Our Services">Our Services</span>
            <h2 class="section-title mt-4" data-zh="本地调查协助服务范围" data-en="Local Investigation Support Services">本地调查协助服务范围</h2>
          </div>
          <p class="section-kicker" data-zh="以实际可执行的中国本地协助为核心，服务内容保持清晰、合规、可沟通。" data-en="Practical mainland China support with clear scope, compliance boundaries, and direct communication.">以实际可执行的中国本地协助为核心，服务内容保持清晰、合规、可沟通。</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {services.map((service) => <ServiceCard service={service} />)}
        </div>
      </div>
    </section>

    <section class="bg-[#edf3f7] py-16">
      <div class="container-page grid gap-8 lg:grid-cols-[1fr_.85fr] lg:items-center">
        <div class="checkup-panel p-7">
          <span class="eyebrow" data-zh="Assessment Report" data-en="Assessment Report">Assessment Report</span>
          <h2 class="mt-4 text-3xl font-black leading-tight text-ink" data-zh="把零散线索整理成可判断的现实情况" data-en="Turn scattered clues into a practical situation assessment">把零散线索整理成可判断的现实情况</h2>
          <p class="mt-4 text-slate-600" data-zh="我们关注的是可理解、可沟通、可用于决策的信息整理，而不是夸张承诺。每个委托会先确认目标、资料基础、风险和可执行方式。" data-en="We focus on clear, decision-useful information rather than exaggerated promises. Each request starts with purpose, information, risk, and feasibility assessment.">我们关注的是可理解、可沟通、可用于决策的信息整理，而不是夸张承诺。每个委托会先确认目标、资料基础、风险和可执行方式。</p>
          <a class="button button-primary mt-6" href="/contact/" data-zh="开始案件评估" data-en="Start Case Assessment">开始案件评估</a>
        </div>
        <blockquote class="border-l-4 border-[#e7a33a] bg-white p-6 text-slate-700 shadow-sm">
          <p class="text-xl font-semibold leading-relaxed" data-zh="“很多跨境关系或债务问题，真正困难的不是信息少，而是不知道哪些线索可信、哪些方式合规。”" data-en="“In many cross-border relationship or debt matters, the challenge is not only missing information, but knowing which clues are reliable and which methods are lawful.”">“很多跨境关系或债务问题，真正困难的不是信息少，而是不知道哪些线索可信、哪些方式合规。”</p>
          <footer class="mt-4 text-sm font-bold text-brand-700" data-zh="中国本地调查协助团队" data-en="Mainland China Local Support Team">中国本地调查协助团队</footer>
        </blockquote>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page">
        <div class="text-center">
          <span class="eyebrow" data-zh="Why Work With Us" data-en="Why Work With Us">Why Work With Us</span>
          <h2 class="section-title mt-4" data-zh="为什么选择星外天调查协助？" data-en="Why Choose Xingwaitian Support?">为什么选择星外天调查协助？</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {why.map((item) => (
            <article class="border-t-4 border-[#e7a33a] bg-slate-50 p-6">
              <h3 class="text-xl font-black text-ink" data-zh={item.zh} data-en={item.en}>{item.zh}</h3>
              <p class="mt-3 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Credentials />

    <TrustGallery />

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[.95fr_1.05fr]">
        <div>
          <span class="eyebrow" data-zh="How It Works" data-en="How It Works">How It Works</span>
          <h2 class="section-title mt-4" data-zh="清晰流程，降低沟通成本" data-en="A Clear Process That Reduces Uncertainty">清晰流程，降低沟通成本</h2>
        </div>
        <ol class="grid gap-4">
          {process.map((item, index) => (
            <li class="card grid grid-cols-[3rem_1fr] gap-4 p-5">
              <span class="grid size-12 place-items-center bg-brand-700 font-black text-white">{index + 1}</span>
              <div>
                <strong class="text-lg text-ink" data-zh={item.zh} data-en={item.en}>{item.zh}</strong>
                <p class="mt-1 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bg-[#f0f4f7] py-16 lg:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div>
          <span class="eyebrow" data-zh="FAQ" data-en="FAQ">FAQ</span>
          <h2 class="section-title mt-4" data-zh="常见问题" data-en="Frequently Asked Questions">常见问题</h2>
          <p class="mt-4 text-slate-600" data-zh="联系前可以先了解基础边界，尤其是合规与保密问题。" data-en="Understand the basic boundaries before contacting us, especially compliance and confidentiality.">联系前可以先了解基础边界，尤其是合规与保密问题。</p>
        </div>
        <FAQ />
      </div>
    </section>

    <CTA />
  </main>
</BaseLayout>
