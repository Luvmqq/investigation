---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/CTA.astro";
import Credentials from "@/components/Credentials.astro";
import FAQ from "@/components/FAQ.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import TrustGallery from "@/components/TrustGallery.astro";
import { faqs } from "@/data/faq";
import { services } from "@/data/services";
import { site } from "@/data/site";

const title = site.defaultTitle;
const description = site.defaultDescription;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.companyEn,
    alternateName: site.companyZh,
    url: site.url,
    sameAs: [site.officialWebsite],
    email: site.email
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.nameEn,
    alternateName: site.nameZh,
    url: site.url
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.qZh,
      acceptedAnswer: { "@type": "Answer", text: faq.aZh }
    }))
  }
];

const audiences = [
  {
    image: "/images/trust/trust-02.png",
    titleZh: "跨境关系判断",
    titleEn: "Relationship Decisions",
    bodyZh: "海外客户在婚恋、家庭或私人关系中，需要了解中国境内对象的真实情况。",
    bodyEn: "For overseas clients who need to understand a relationship or private situation in mainland China."
  },
  {
    image: "/images/trust/trust-04.png",
    titleZh: "私人背景评估",
    titleEn: "Private Background Assessment",
    bodyZh: "围绕公开信息、现实线索和可行边界，做谨慎的信息整理与风险判断。",
    bodyEn: "Organize public information, practical clues, and risk indicators within lawful boundaries."
  },
  {
    image: "/images/trust/trust-03.png",
    titleZh: "寻人与债务线索",
    titleEn: "Locating and Debt Clues",
    bodyZh: "为失联亲友、前任、债务人等场景提供中国大陆本地协助。",
    bodyEn: "Local support for locating missing contacts, former partners, relatives, or debtor clues."
  }
];

const reportItems = [
  { zh: "关系真实性与生活状态线索", en: "Relationship and lifestyle consistency clues" },
  { zh: "公开信息、登记信息与线下情况整理", en: "Public information, registration clues, and offline context" },
  { zh: "寻人、债务人位置线索与沟通可行性", en: "Locating clues, debtor context, and communication feasibility" },
  { zh: "风险提示、合规边界与后续建议", en: "Risk notes, compliance boundaries, and next-step suggestions" }
];

const why = [
  { icon: "01", zh: "中立", en: "Unbiased", bodyZh: "先评估资料基础与可执行方式，不用夸张承诺推动成交。", bodyEn: "We first review information quality and feasibility instead of pushing exaggerated promises." },
  { icon: "02", zh: "保密", en: "Confidential", bodyZh: "私人委托资料谨慎处理，减少不必要的信息扩散。", bodyEn: "Private case information is handled carefully with limited exposure." },
  { icon: "03", zh: "便捷", en: "Convenient", bodyZh: "面向海外客户远程沟通，流程清晰，反馈可理解。", bodyEn: "Remote communication for overseas clients with clear process and understandable feedback." },
  { icon: "04", zh: "中国本地经验", en: "China Expertise", bodyZh: "结合中国大陆城市线索、沟通环境和现实情况判断。", bodyEn: "Grounded in mainland China local context, city clues, and practical communication habits." }
];

const process = [
  { zh: "提交情况", en: "Submit Context", bodyZh: "说明背景、所在国家和你需要确认的问题。", bodyEn: "Share the background, your country, and what you need to clarify." },
  { zh: "合规评估", en: "Compliance Review", bodyZh: "确认目的是否合法、资料是否足够、是否适合接案。", bodyEn: "We review purpose, available information, legality, and suitability." },
  { zh: "本地协助", en: "Local Support", bodyZh: "按约定范围进行公开信息研究、线索整理或线下核实。", bodyEn: "Public information research, clue organization, or offline verification within the agreed scope." },
  { zh: "结果反馈", en: "Result Summary", bodyZh: "以可理解的方式总结现实情况、风险和下一步建议。", bodyEn: "Receive a clear summary of the situation, risks, and possible next steps." }
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <main>
    <section class="relative overflow-hidden bg-[#eaf3f8]">
      <div class="absolute inset-x-0 bottom-0 h-24 bg-white"></div>
      <div class="container-page relative grid min-h-[620px] gap-10 py-12 lg:grid-cols-[1fr_.92fr] lg:items-center lg:py-16">
        <div>
          <a class="button button-primary mb-8" href="/contact/" data-zh="提交调查协助咨询" data-en="Request Investigation Support">提交调查协助咨询</a>
          <h1 class="max-w-4xl text-4xl font-black leading-[1.05] text-[#153f5d] sm:text-5xl md:text-6xl" data-zh="中国大陆本地调查协助服务" data-en="Objective Support for Mainland China Matters">中国大陆本地调查协助服务</h1>
          <p class="mt-5 max-w-xl text-xl font-semibold text-[#567284]" data-zh="Fact-check. Assess. Make safer personal and financial decisions." data-en="Fact-check. Assess. Make safer personal and financial decisions.">Fact-check. Assess. Make safer personal and financial decisions.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button button-primary" href="#services" data-zh="查看服务" data-en="Our Services">查看服务</a>
            <a class="button button-secondary" href={site.officialWebsite} target="_blank" rel="noopener noreferrer" data-zh="访问星外天官网" data-en="Official Website">访问星外天官网</a>
          </div>
        </div>

        <div class="relative">
          <div class="hero-photo-frame">
            <img class="aspect-[4/3] w-full object-cover" src="/images/china-business-scene.svg" alt="China local investigation support visual" loading="eager" />
          </div>
          <div class="absolute -bottom-6 left-4 right-4 grid grid-cols-3 divide-x divide-slate-200 bg-white shadow-[0_18px_38px_rgba(25,62,84,.16)]">
            <div class="p-4 text-center">
              <strong class="block text-2xl font-black text-brand-700">10+</strong>
              <span class="text-xs font-bold text-slate-600" data-zh="年经验" data-en="Years">年经验</span>
            </div>
            <div class="p-4 text-center">
              <strong class="block text-2xl font-black text-brand-700">4</strong>
              <span class="text-xs font-bold text-slate-600" data-zh="服务方向" data-en="Services">服务方向</span>
            </div>
            <div class="p-4 text-center">
              <strong class="block text-2xl font-black text-brand-700">6</strong>
              <span class="text-xs font-bold text-slate-600" data-zh="资质图片" data-en="Credentials">资质图片</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page">
        <h2 class="text-center text-3xl font-black text-ink md:text-4xl" data-zh="谁会使用我们的调查协助？" data-en="Who Uses Our Investigation Support?">谁会使用我们的调查协助？</h2>
        <p class="mx-auto mt-3 max-w-3xl text-center text-slate-600" data-zh="客户通常需要在关系、债务、家庭或私人决策前减少不确定性，并希望获得中国本地视角的判断。" data-en="Clients usually need to reduce uncertainty before relationship, debt, family, or private decisions with a mainland China perspective.">客户通常需要在关系、债务、家庭或私人决策前减少不确定性，并希望获得中国本地视角的判断。</p>
        <div class="mt-10 grid gap-8 md:grid-cols-3">
          {audiences.map((item) => (
            <article class="audience-card">
              <img class="aspect-[4/3] w-full object-cover" src={item.image} alt={item.titleZh} loading="lazy" />
              <div class="px-3 pt-5 text-center">
                <h3 class="text-xl font-black text-ink" data-zh={item.titleZh} data-en={item.titleEn}>{item.titleZh}</h3>
                <p class="mt-3 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="services" class="bg-[#f0f6fa] py-16 lg:py-20">
      <div class="container-page grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
        <div>
          <h2 class="text-3xl font-black leading-tight text-ink md:text-4xl" data-zh="本地调查协助服务" data-en="Local Investigation Support Services">本地调查协助服务</h2>
          <p class="mt-4 text-lg text-slate-600" data-zh="保留当前站点业务范围：婚恋关系调查、个人背景了解、寻人协助、债务人线索调查。所有委托先评估合法性与可行性。" data-en="Our current service scope remains: relationship investigation, personal background assessment, locating assistance, and debtor clue support. Every request is reviewed for legality and feasibility first.">保留当前站点业务范围：婚恋关系调查、个人背景了解、寻人协助、债务人线索调查。所有委托先评估合法性与可行性。</p>
          <a class="button button-primary mt-6" href="/contact/" data-zh="提交咨询" data-en="Start Inquiry">提交咨询</a>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          {services.map((service) => <ServiceCard service={service} />)}
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page grid gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center">
        <div class="report-preview">
          <div class="report-bar"></div>
          <h2 class="text-3xl font-black text-[#153f5d]" data-zh="情况评估与线索整理报告" data-en="Situation Assessment and Clue Summary">情况评估与线索整理报告</h2>
          <p class="mt-3 text-slate-600" data-zh="把零散资料整理成可判断、可沟通、可决策的现实情况说明。" data-en="Turn scattered materials into a clear, communicable, decision-useful situation summary.">把零散资料整理成可判断、可沟通、可决策的现实情况说明。</p>
          <ul class="mt-6 grid gap-3">
            {reportItems.map((item) => (
              <li class="flex gap-3 text-sm font-semibold text-slate-700">
                <span class="mt-1 grid size-5 shrink-0 place-items-center bg-brand-700 text-xs text-white">✓</span>
                <span data-zh={item.zh} data-en={item.en}>{item.zh}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-3xl font-black leading-tight text-ink md:text-4xl" data-zh="在重要决定前，先确认中国境内真实情况" data-en="Clarify the Situation in China Before Important Decisions">在重要决定前，先确认中国境内真实情况</h2>
          <p class="mt-4 text-lg text-slate-600" data-zh="我们不提供黑客、定位、银行流水、酒店记录、通信记录等违法服务。我们提供的是可执行的本地协助、公开信息研究、线索整理和合规风险提示。" data-en="We do not provide hacking, tracking, bank records, hotel records, communication records, or unlawful information access. We provide practical local support, public information research, clue organization, and compliance risk notes.">我们不提供黑客、定位、银行流水、酒店记录、通信记录等违法服务。我们提供的是可执行的本地协助、公开信息研究、线索整理和合规风险提示。</p>
          <a class="button button-primary mt-6" href="/contact/" data-zh="开始案件评估" data-en="Start Case Assessment">开始案件评估</a>
        </div>
      </div>
    </section>

    <section class="bg-[#f0f6fa] py-14">
      <div class="container-page max-w-4xl text-center">
        <blockquote class="text-2xl font-semibold leading-relaxed text-[#153f5d]" data-zh="“很多跨境关系或债务问题，真正困难的不是信息少，而是不知道哪些线索可信、哪些方式合规。”" data-en="“In many cross-border relationship or debt matters, the challenge is not only missing information, but knowing which clues are reliable and which methods are lawful.”">“很多跨境关系或债务问题，真正困难的不是信息少，而是不知道哪些线索可信、哪些方式合规。”</blockquote>
        <p class="mt-5 text-sm font-black uppercase tracking-[.16em] text-brand-700" data-zh="中国本地调查协助团队" data-en="Mainland China Local Support Team">中国本地调查协助团队</p>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page">
        <h2 class="text-center text-3xl font-black text-ink md:text-4xl" data-zh="为什么选择星外天调查协助？" data-en="Why Work With Xingwaitian Support?">为什么选择星外天调查协助？</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
          {why.map((item) => (
            <article class="why-item text-center">
              <div class="mx-auto grid size-20 place-items-center rounded-full bg-[#eaf3f8] text-xl font-black text-brand-700">{item.icon}</div>
              <h3 class="mt-5 text-lg font-black text-ink" data-zh={item.zh} data-en={item.en}>{item.zh}</h3>
              <p class="mt-3 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#f0f6fa] py-16">
      <div class="container-page grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div>
          <h2 class="text-3xl font-black leading-tight text-ink md:text-4xl" data-zh="10+年行业经验，专业机构，诚信服务" data-en="10+ Years Experience. Professional Organization. Integrity Service.">10+年行业经验，专业机构，诚信服务</h2>
          <p class="mt-4 text-lg text-slate-600" data-zh="结合星外天官网公开信息、资质图片和本地服务经验，本站以更适合海外客户的方式呈现可信、合规、可沟通的调查协助服务。" data-en="Based on Xingwaitian's public official information, credential images, and local service experience, this site presents a more trustworthy and compliance-aware support service for overseas clients.">结合星外天官网公开信息、资质图片和本地服务经验，本站以更适合海外客户的方式呈现可信、合规、可沟通的调查协助服务。</p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <span class="text-2xl font-black text-[#e7a33a]">★★★★★</span>
            <strong class="text-brand-800" data-zh="诚信、保密、合规边界清晰" data-en="Integrity, confidentiality, and clear compliance boundaries">诚信、保密、合规边界清晰</strong>
          </div>
        </div>
        <ol class="grid gap-4">
          {process.map((item, index) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 bg-white p-5 shadow-[0_12px_28px_rgba(25,62,84,.08)]">
              <span class="grid size-12 place-items-center bg-brand-700 font-black text-white">{index + 1}</span>
              <div>
                <strong class="text-lg text-ink" data-zh={item.zh} data-en={item.en}>{item.zh}</strong>
                <p class="mt-1 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Credentials />

    <TrustGallery />

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div>
          <h2 class="text-3xl font-black text-ink md:text-4xl" data-zh="常见问题" data-en="Frequently Asked Questions">常见问题</h2>
          <p class="mt-4 text-slate-600" data-zh="联系前可以先了解基础边界，尤其是合规、保密和可行性评估。" data-en="Understand the basic boundaries before contacting us, especially compliance, confidentiality, and feasibility assessment.">联系前可以先了解基础边界，尤其是合规、保密和可行性评估。</p>
        </div>
        <FAQ />
      </div>
    </section>

    <CTA />
  </main>
</BaseLayout>
