---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/CTA.astro";
import Credentials from "@/components/Credentials.astro";
import FAQ from "@/components/FAQ.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import TrustGallery from "@/components/TrustGallery.astro";
import { faqs } from "@/data/faq";
import { services } from "@/data/services";
import { site } from "@/data/site";

const title = site.defaultTitle;
const description = site.defaultDescription;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.companyEn,
    alternateName: site.companyZh,
    url: site.url,
    sameAs: [site.officialWebsite],
    email: site.email
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.nameEn,
    alternateName: site.nameZh,
    url: site.url
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.qZh,
      acceptedAnswer: { "@type": "Answer", text: faq.aZh }
    }))
  }
];

const audiences = [
  {
    image: "/images/trust/trust-02.png",
    titleZh: "海外华人",
    titleEn: "Overseas Chinese Clients",
    bodyZh: "需要了解中国境内关系对象、亲友、前任或债务人的现实情况。",
    bodyEn: "Understand the practical situation of a person, relative, former partner, or debtor in China."
  },
  {
    image: "/images/trust/trust-04.png",
    titleZh: "跨境家庭与私人委托",
    titleEn: "Cross-border Family and Private Matters",
    bodyZh: "在婚恋、家庭、财务或重要私人决策前，需要降低不确定性。",
    bodyEn: "Reduce uncertainty before relationship, family, financial, or private decisions."
  },
  {
    image: "/images/trust/trust-03.png",
    titleZh: "境外企业或专业人士",
    titleEn: "Overseas Businesses and Professionals",
    bodyZh: "需要本地公开信息研究、线索整理与中国现实环境判断。",
    bodyEn: "Need local public information research, clue organization, and China-context assessment."
  }
];

const reportItems = [
  { zh: "婚恋关系与生活状态真实性判断", en: "Relationship and lifestyle consistency assessment" },
  { zh: "个人公开信息、背景线索与风险提示", en: "Public information, background clues, and risk notes" },
  { zh: "寻人、债务人线索与本地沟通可行性", en: "Locating support, debtor clues, and communication feasibility" },
  { zh: "合规边界、可执行范围与后续建议", en: "Compliance boundaries, feasible scope, and next-step suggestions" }
];

const why = [
  { value: "01", zh: "专业机构", en: "Professional Organization", bodyZh: "以正规主体和公开资质为基础，面向海外客户提供清晰服务。", bodyEn: "Clear support for overseas clients backed by a registered entity and public credentials." },
  { value: "02", zh: "10+年经验", en: "10+ Years Experience", bodyZh: "结合长期本地服务经验，理解中国大陆现实沟通环境和城市线索。", bodyEn: "Long-term local service experience with mainland China communication and city-context understanding." },
  { value: "03", zh: "诚信服务", en: "Integrity Service", bodyZh: "先评估后接案，不夸大承诺，不诱导违法委托。", bodyEn: "Assessment before acceptance, no exaggerated promises, and no encouragement of unlawful requests." },
  { value: "04", zh: "保密合规", en: "Confidential and Compliant", bodyZh: "不提供黑客、定位、记录查询等违法服务，降低委托风险。", bodyEn: "No hacking, tracking, record lookup, or unlawful services, reducing client risk." }
];

const process = [
  { zh: "提交背景", en: "Submit Context", bodyZh: "说明你所在国家、事情背景和希望确认的问题。", bodyEn: "Share your country, background context, and the questions you need to clarify." },
  { zh: "初步评估", en: "Initial Review", bodyZh: "判断合法性、资料基础、可行性和服务边界。", bodyEn: "Review legality, available information, feasibility, and service boundaries." },
  { zh: "本地协助", en: "Local Support", bodyZh: "在约定范围内做公开信息研究、线索整理或线下协助。", bodyEn: "Conduct public information research, clue organization, or offline support within scope." },
  { zh: "结果反馈", en: "Result Summary", bodyZh: "提供清晰、可理解、便于决策的情况总结。", bodyEn: "Provide a clear, understandable, decision-useful summary." }
];

const trustStrip = [
  { zh: "10+年行业经验", en: "10+ Years Experience" },
  { zh: "专业机构", en: "Professional Organization" },
  { zh: "诚信服务", en: "Integrity Service" },
  { zh: "合规保密", en: "Compliance and Confidentiality" }
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <main class="bg-white">
    <section class="border-b border-slate-200 bg-white">
      <div class="container-page grid gap-12 py-16 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-24">
        <div>
          <p class="text-sm font-black uppercase tracking-[.18em] text-brand-700" data-zh="B2B 跨境核验与本地调查协助" data-en="Cross-border Verification and Local Investigation Support">B2B 跨境核验与本地调查协助</p>
          <h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.05] text-[#102033] sm:text-5xl md:text-6xl" data-zh="中国大陆本地调查协助服务" data-en="Mainland China Investigation Support">中国大陆本地调查协助服务</h1>
          <p class="mt-6 max-w-2xl text-lg text-slate-600" data-zh="面向海外华人和跨境客户，提供婚恋关系调查、个人背景了解、寻人协助、债务人线索调查与私人委托协助。先评估合法性与可行性，再决定是否接受委托。" data-en="For overseas Chinese and cross-border clients, we support relationship checks, personal background assessment, locating assistance, debtor clue investigation, and private matter review. Every request is assessed for legality and feasibility first.">面向海外华人和跨境客户，提供婚恋关系调查、个人背景了解、寻人协助、债务人线索调查与私人委托协助。先评估合法性与可行性，再决定是否接受委托。</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button button-primary" href="/contact/" data-zh="提交咨询" data-en="Start Inquiry">提交咨询</a>
            <a class="button button-secondary" href="#services" data-zh="查看服务范围" data-en="View Services">查看服务范围</a>
            <a class="button button-secondary" href={site.officialWebsite} target="_blank" rel="noopener noreferrer" data-zh="星外天官网" data-en="Official Website">星外天官网</a>
          </div>
        </div>

        <div class="hero-business-panel">
          <img class="aspect-[4/3] w-full object-cover" src="/images/china-business-scene.svg" alt="Mainland China investigation support" loading="eager" />
          <div class="grid border-t border-slate-200 md:grid-cols-3">
            <div class="hero-stat">
              <strong>10+</strong>
              <span data-zh="年行业经验" data-en="Years experience">年行业经验</span>
            </div>
            <div class="hero-stat">
              <strong>4</strong>
              <span data-zh="核心服务" data-en="Core services">核心服务</span>
            </div>
            <div class="hero-stat">
              <strong>6</strong>
              <span data-zh="信任资质" data-en="Trust assets">信任资质</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-14">
      <div class="container-page grid gap-4 border-y border-slate-200 py-8 md:grid-cols-4">
        {trustStrip.map((item) => (
          <div class="trust-strip-item" data-zh={item.zh} data-en={item.en}>{item.zh}</div>
        ))}
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-3xl text-center">
          <p class="section-label" data-zh="Who Uses Us" data-en="Who Uses Us">Who Uses Us</p>
          <h2 class="section-title mt-3" data-zh="谁需要中国本地调查协助？" data-en="Who Needs China Local Investigation Support?">谁需要中国本地调查协助？</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {audiences.map((item) => (
            <article class="business-card overflow-hidden">
              <img class="aspect-[16/10] w-full object-cover" src={item.image} alt={item.titleZh} loading="lazy" />
              <div class="p-7">
                <h3 class="text-xl font-black text-ink" data-zh={item.titleZh} data-en={item.titleEn}>{item.titleZh}</h3>
                <p class="mt-4 text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="services" class="border-y border-slate-200 bg-[#f8fafc] py-16 lg:py-20">
      <div class="container-page">
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <p class="section-label" data-zh="Services" data-en="Services">Services</p>
            <h2 class="section-title mt-3" data-zh="本地调查协助服务" data-en="Investigation Support Services">本地调查协助服务</h2>
          </div>
          <p class="text-lg text-slate-600" data-zh="服务范围围绕当前站点业务：关系调查、背景了解、寻人协助与债务人线索调查。每项服务都需要先做合规与可行性评估。" data-en="The service scope remains focused on relationship investigation, background assessment, locating assistance, and debtor clue support. Each service starts with compliance and feasibility review.">服务范围围绕当前站点业务：关系调查、背景了解、寻人协助与债务人线索调查。每项服务都需要先做合规与可行性评估。</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {services.map((service) => <ServiceCard service={service} />)}
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-24">
      <div class="container-page grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="section-label" data-zh="Assessment" data-en="Assessment">Assessment</p>
          <h2 class="section-title mt-3" data-zh="把零散线索整理成可判断的现实情况" data-en="Turn Scattered Clues Into a Practical Assessment">把零散线索整理成可判断的现实情况</h2>
          <p class="mt-5 text-lg text-slate-600" data-zh="我们提供的是可沟通、可决策、边界清晰的情况评估，而不是夸张承诺。所有委托都以合法、正当、可执行为前提。" data-en="We provide clear, decision-useful assessment with defined boundaries, not exaggerated promises. Every request must be lawful, legitimate, and feasible.">我们提供的是可沟通、可决策、边界清晰的情况评估，而不是夸张承诺。所有委托都以合法、正当、可执行为前提。</p>
          <a class="button button-primary mt-7" href="/contact/" data-zh="开始案件评估" data-en="Start Case Assessment">开始案件评估</a>
        </div>
        <div class="report-document">
          <div class="report-document-header">
            <span data-zh="Case Assessment" data-en="Case Assessment">Case Assessment</span>
            <strong data-zh="中国本地情况评估" data-en="China Local Situation Review">中国本地情况评估</strong>
          </div>
          <ul class="mt-6 grid gap-4">
            {reportItems.map((item) => (
              <li class="flex gap-3 border-b border-slate-100 pb-4 text-sm font-semibold text-slate-700">
                <span class="grid size-6 shrink-0 place-items-center bg-brand-700 text-xs text-white">✓</span>
                <span data-zh={item.zh} data-en={item.en}>{item.zh}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-[#102033] py-16 text-white lg:py-20">
      <div class="container-page grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-center">
        <div>
          <p class="text-sm font-black uppercase tracking-[.18em] text-[#e7a33a]" data-zh="Trust" data-en="Trust">Trust</p>
          <h2 class="mt-3 text-3xl font-black leading-tight md:text-4xl" data-zh="高信任商务风格，清晰表达服务边界" data-en="High-trust Business Positioning With Clear Boundaries">高信任商务风格，清晰表达服务边界</h2>
          <p class="mt-5 text-white/75" data-zh="不提供黑客、定位、银行流水、酒店记录、通信记录等违法服务。我们强调专业机构、诚信服务、保密沟通和现实可行性。" data-en="No hacking, tracking, bank records, hotel records, communication records, or unlawful information access. We emphasize professional organization, integrity, confidentiality, and practical feasibility.">不提供黑客、定位、银行流水、酒店记录、通信记录等违法服务。我们强调专业机构、诚信服务、保密沟通和现实可行性。</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {why.map((item) => (
            <article class="border border-white/15 bg-white/5 p-6">
              <span class="text-sm font-black text-[#e7a33a]">{item.value}</span>
              <h3 class="mt-3 text-xl font-black" data-zh={item.zh} data-en={item.en}>{item.zh}</h3>
              <p class="mt-3 text-sm text-white/70" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page">
        <div class="expertise-band">
          <div>
            <p class="section-label" data-zh="Experience" data-en="Experience">Experience</p>
            <h2 class="mt-3 text-3xl font-black leading-tight text-ink md:text-4xl" data-zh="中国本地调查协助专业机构，10+年行业经验" data-en="China Local Investigation Support With 10+ Years Experience">中国本地调查协助专业机构，10+年行业经验</h2>
            <p class="mt-4 text-lg text-slate-600" data-zh="基于星外天官网公开信息和资质展示，本站以更适合海外客户的方式呈现合规、保密、可沟通的本地调查协助服务。" data-en="Based on public Xingwaitian information and credential materials, this site presents local investigation support in a compliance-aware, confidential, and overseas-client-friendly way.">基于星外天官网公开信息和资质展示，本站以更适合海外客户的方式呈现合规、保密、可沟通的本地调查协助服务。</p>
          </div>
          <div class="expertise-score">
            <div class="text-3xl font-black text-[#e7a33a]">★★★★★</div>
            <strong class="mt-3 block text-xl text-ink" data-zh="专业机构 · 诚信服务" data-en="Professional · Integrity">专业机构 · 诚信服务</strong>
            <p class="mt-2 text-sm text-slate-600" data-zh="所有委托先评估合法性、可行性与风险边界。" data-en="Every request starts with legality, feasibility, and risk boundary assessment.">所有委托先评估合法性、可行性与风险边界。</p>
            <a class="button button-primary mt-5 w-full" href="/contact/" data-zh="提交咨询" data-en="Start Inquiry">提交咨询</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
        <div>
          <p class="section-label" data-zh="Process" data-en="Process">Process</p>
          <h2 class="section-title mt-3" data-zh="清晰流程，降低跨境沟通成本" data-en="A Clear Process for Cross-border Communication">清晰流程，降低跨境沟通成本</h2>
        </div>
        <ol class="grid gap-4">
          {process.map((item, index) => (
            <li class="business-card grid grid-cols-[3rem_1fr] gap-4 p-5">
              <span class="grid size-12 place-items-center bg-brand-700 font-black text-white">{index + 1}</span>
              <div>
                <strong class="text-lg text-ink" data-zh={item.zh} data-en={item.en}>{item.zh}</strong>
                <p class="mt-1 text-sm text-slate-600" data-zh={item.bodyZh} data-en={item.bodyEn}>{item.bodyZh}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Credentials />

    <TrustGallery />

    <section class="border-t border-slate-200 bg-white py-16 lg:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div>
          <p class="section-label" data-zh="FAQ" data-en="FAQ">FAQ</p>
          <h2 class="section-title mt-3" data-zh="常见问题" data-en="Frequently Asked Questions">常见问题</h2>
          <p class="mt-4 text-slate-600" data-zh="联系前可以先了解基础边界，尤其是合规、保密和可行性评估。" data-en="Understand the basic boundaries before contacting us, especially compliance, confidentiality, and feasibility assessment.">联系前可以先了解基础边界，尤其是合规、保密和可行性评估。</p>
        </div>
        <FAQ />
      </div>
    </section>

    <CTA />
  </main>
</BaseLayout>
